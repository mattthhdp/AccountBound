diff --git a/src/server/game/Achievements/AchievementMgr.cpp b/src/server/game/Achievements/AchievementMgr.cpp
index f0aa9da38..fde6db0f5 100644
--- a/src/server/game/Achievements/AchievementMgr.cpp
+++ b/src/server/game/Achievements/AchievementMgr.cpp
@@ -2394,0 +2395,26 @@ void AchievementMgr::CompletedAchievement(AchievementEntry const* achievement)
+bool AchievementMgr::AddAccountBoundAchievement(AchievementEntry const* achievement, time_t date)
+{
+    if (!achievement || achievement->flags & ACHIEVEMENT_FLAG_COUNTER || HasAchieved(achievement->ID))
+        return false;
+
+    CompletedAchievementData& completedAchievement = _completedAchievements[achievement->ID];
+    completedAchievement.date = date;
+    completedAchievement.changed = false;
+
+    // The module persists imports before attaching them to the loaded player.
+    // Restore title rewards without resending mail, items or announcements.
+    if (AchievementReward const* reward = sAchievementMgr->GetAchievementReward(achievement))
+    {
+        uint8 rewardIndex = achievement->ID == 1793
+            ? GetPlayer()->getGender()
+            : uint8(GetPlayer()->GetTeamId());
+
+        if (uint32 titleId = reward->titleId[rewardIndex])
+            if (CharTitlesEntry const* titleEntry = sCharTitlesStore.LookupEntry(titleId))
+                if (!GetPlayer()->HasTitle(titleEntry))
+                    GetPlayer()->SetTitle(titleEntry);
+    }
+
+    return true;
+}
+
